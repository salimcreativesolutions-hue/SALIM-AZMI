  <script>
    /* Captions appear progressively as each image's bottom rises into view */
    (function () {
      var caps = Array.prototype.slice.call(document.querySelectorAll(".pw-cap"));
      var items = caps.map(function (c) { return c.previousElementSibling; });
      var tick = false;
      function update() {
        tick = false;
        var vh = window.innerHeight;
        for (var i = 0; i < caps.length; i++) {
          var b = items[i].getBoundingClientRect().bottom;
          var p = (vh * 0.97 - b) / (vh * 0.3);
          caps[i].style.setProperty("--r", Math.max(0, Math.min(1, p)).toFixed(3));
        }
      }
      function req() { if (!tick) { tick = true; requestAnimationFrame(update); } }
      window.addEventListener("scroll", req, { passive: true });
      window.addEventListener("resize", req);
      update();
    })();
  </script>
  <script>
    (function () {
      var el = document.getElementById("sf-clock"); if (!el) return;
      function tick() {
        try {
          var f = new Intl.DateTimeFormat("fr-FR", { timeZone: "Africa/Casablanca", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZoneName: "shortOffset" });
          var p = f.formatToParts(new Date()), g = function (t) { return (p.find(function (x) { return x.type === t; }) || {}).value || ""; };
          el.textContent = g("hour") + ":" + g("minute") + ":" + g("second") + " " + g("timeZoneName").replace("UTC", "GMT");
        } catch (e) { el.textContent = ""; }
      }
      tick(); setInterval(tick, 1000);
    })();
  </script>
