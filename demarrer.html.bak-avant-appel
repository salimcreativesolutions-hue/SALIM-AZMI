  <script>
    (() => {
      // Formspree: create a form at formspree.io and paste its ID here (https://formspree.io/f/xxxxxxx)
      const ENDPOINT = "https://formspree.io/f/VOTRE_ID_FORMSPREE";

      const form = document.getElementById("start-form");
      const thanks = document.getElementById("form-thanks");
      const error = document.getElementById("form-error");
      const send = form.querySelector(".send");
      const fields = form.querySelectorAll(".fld");
      const name = form.elements.nom;
      const email = form.elements.email;
      const phone = form.elements.telephone;
      const budget = form.elements.budget;
      const options = form.querySelectorAll(".opt");

      // Inline fields grow with their text (or placeholder), like words in the sentence
      const mirror = document.createElement("span");
      mirror.style.cssText = "position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0";
      document.body.appendChild(mirror);
      const autosize = (el) => {
        const cs = getComputedStyle(el);
        mirror.style.font = cs.font;
        mirror.style.letterSpacing = cs.letterSpacing;
        mirror.textContent = el.tagName === "SELECT" ? el.options[el.selectedIndex].text : (el.value || el.placeholder);
        el.style.width = `${mirror.offsetWidth + (el.tagName === "SELECT" ? 30 : 4)}px`;
      };
      const sizeAll = () => fields.forEach(autosize);
      document.fonts.ready.then(sizeAll);
      addEventListener("resize", sizeAll);
      sizeAll();

      const isReady = () => name.value.trim() !== "" && (email.value.trim() !== "" || phone.value.trim() !== "");
      const refresh = () => {
        send.classList.toggle("ready", isReady());
        budget.classList.toggle("is-empty", budget.value === "");
        if (isReady()) error.hidden = true;
      };
      fields.forEach((el) => el.addEventListener("input", () => { autosize(el); refresh(); }));
      budget.addEventListener("change", () => { autosize(budget); refresh(); });
      refresh();

      options.forEach((btn) => btn.addEventListener("click", () => {
        btn.setAttribute("aria-pressed", String(btn.getAttribute("aria-pressed") !== "true"));
      }));

      const showError = (text) => { error.textContent = text; error.hidden = false; };

      // Escape closes the page, like the ✕ button
      addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !e.defaultPrevented) location.href = "contact.html";
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!isReady()) {
          showError("Indiquez votre nom et un email ou un numéro pour que je puisse vous répondre.");
          (name.value.trim() === "" ? name : email).focus();
          return;
        }

        const data = new FormData();
        data.append("nom", name.value.trim());
        data.append("entreprise", form.elements.entreprise.value.trim());
        data.append("services", [...options].filter((b) => b.getAttribute("aria-pressed") === "true")
          .map((b) => b.textContent.trim()).join(", ") || "—");
        data.append("budget", budget.value || "—");
        data.append("email", email.value.trim() || "—");
        data.append("telephone", phone.value.trim() || "—");
        data.append("_subject", `Démarrer un projet — ${name.value.trim()}`);
        if (email.value.trim()) data.append("_replyto", email.value.trim());

        send.setAttribute("aria-busy", "true");
        send.firstElementChild.textContent = "Envoi…";
        try {
          if (ENDPOINT.includes("VOTRE_ID")) throw new Error("Formspree ID missing");
          const res = await fetch(ENDPOINT, { method: "POST", body: data, headers: { Accept: "application/json" } });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          thanks.querySelector("[data-first-name]").textContent = name.value.trim().split(/\s+/)[0];
          error.hidden = true;
          form.hidden = true;
          thanks.hidden = false;
          thanks.setAttribute("tabindex", "-1");
          thanks.focus();
        } catch (err) {
          console.error(err);
          showError("L'envoi n'a pas abouti. Réessayez dans un instant ou écrivez-moi directement par email.");
        } finally {
          send.removeAttribute("aria-busy");
          send.firstElementChild.textContent = "Envoyer la demande";
        }
      });
    })();
  </script>
</body>
</html>
