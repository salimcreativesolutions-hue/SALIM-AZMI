    .opt .dot { width: 9px; height: 9px; border-radius: 50%; border: 1px solid currentColor; transition: background-color .25s ease; }
    .opt:hover { background: #B9BCC3; }
    .opt[aria-pressed="true"] { background: #0B0C0E; color: #FFFFFF; }
    .opt[aria-pressed="true"] .dot { background: #FFFFFF; border-color: #FFFFFF; }
    .opt:focus-visible { outline: 1px solid #0B0C0E; outline-offset: 3px; }

    /* Send button: grey, slightly darker on hover */
    .send { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: space-between; gap: 16px; height: 44px;
            min-width: 240px; padding: 0 4px 0 20px; border-radius: 999px; background: #C7CAD1; color: #FFFFFF;
            font-family: "Geist Mono", ui-monospace, "SFMono-Regular", monospace; font-size: 13px; line-height: 18px;
            text-transform: uppercase; letter-spacing: 0.04em; transition: background-color .3s ease; }
    .send:hover, .send:focus-visible { background: #ADB0B7; }
    .send:focus-visible { outline: 1px solid #0B0C0E; outline-offset: 3px; }
    .send-icon { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px;
                 border-radius: 50%; background: rgba(255, 255, 255, 0.16); }
    #form-thanks .send { justify-content: center; padding: 0 20px; }

    @media (prefers-reduced-motion: reduce) {
      .fld, .opt, .opt .dot, .send { transition: none; }
    }
  </style>
