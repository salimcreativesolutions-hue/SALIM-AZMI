  <style>
    html { background: #FFFFFF; color: #0B0C0E; -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }
    body { font-family: "Inter Tight", "Helvetica Neue", Arial, sans-serif; }
    ::selection { background: #0B0C0E; color: #FFFFFF; }
    a:focus-visible, button:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }

    /* Label style, used everywhere */
    .label { font-family: "Geist Mono", ui-monospace, "SFMono-Regular", monospace; font-weight: 400;
             font-size: 12px; line-height: 16px; text-transform: uppercase; letter-spacing: 0.04em; color: #6B6F78; }
    .mono-row { font-family: "Geist Mono", ui-monospace, "SFMono-Regular", monospace; font-size: 13px; line-height: 18px;
                text-transform: uppercase; letter-spacing: 0.02em; }

    /* Fixed header: inverts against whatever is behind it */
    .site-header { mix-blend-mode: difference; color: #FFFFFF; pointer-events: none; }
    .site-header a, .site-header button { pointer-events: auto; }

    /* Header hides once the footer covers more than half the screen */
    .hdr { transition: opacity .45s cubic-bezier(.22, 1, .36, 1), transform .45s cubic-bezier(.22, 1, .36, 1); }
    .hdr.hide { opacity: 0; transform: translateY(-16px); }
    .hdr.hide * { pointer-events: none; }

    /* Hero: sticky so the content slides over it */
    .hero { position: sticky; top: 0; z-index: 0; height: 100vh; min-height: 560px; max-height: 1400px;
            transform-origin: center top; }

    /* Hero name: fit() sets the exact size; this is the fallback before it runs */
    .hero-name { font-size: calc((100vw - 48px) / 5.05); font-weight: 500; line-height: 0.8;
                 letter-spacing: -0.035em; white-space: nowrap; padding-top: 0.12em; }

    /* Brandmark hover */
    .bm { display: flex; width: fit-content; transform-origin: left center;
          transition: transform .35s cubic-bezier(.22, 1, .36, 1); }
    .bm:hover, .bm:focus-visible { transform: scale(1.12); }

    /* Slot-machine roll: --lh is the line height of the link */
    .roll { --lh: 22px; }
    .roll .w { display: inline-flex; overflow: hidden; height: var(--lh); line-height: var(--lh); }
    .roll .l { display: inline-block; text-shadow: 0 var(--lh) 0 currentColor;
               transition: transform .45s cubic-bezier(.65, 0, .35, 1); transition-delay: calc(var(--i) * 25ms); }
    .roll:hover .l, .roll:focus-visible .l { transform: translateY(calc(var(--lh) * -1)); }

    /* Projects: 10px frame and gaps */
    .blocks { display: flex; flex-direction: column; gap: 10px; padding: 10px; }
    .row { --p: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .tile { position: relative; display: block; overflow: hidden; aspect-ratio: 86 / 100; color: #0B0C0E; }
    .tile.full { grid-column: 1 / -1; aspect-ratio: 157 / 100; }
    .tile .bg { position: absolute; inset: 0; }
    /* Scroll-linked: JS sets --p on each row (0 = centre, 1 = bottom), no transition */
    .tile .info { position: absolute; left: 24px; right: 24px;
                  top: calc(50% + (50% - 24px) * var(--p)); transform: translateY(calc(-50% - 50% * var(--p)));
                  display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
    .tile:focus-visible { outline: 1px solid #0B0C0E; outline-offset: 3px; }

    /* "Voir tous les projets": 10px frame + 14px padding = 24px page edge */
    .see-all { display: flex; align-items: center; justify-content: space-between; padding: 56px 14px 8px; margin-top: -10px; color: #0B0C0E; } /* cancel the 10px row gap */
    .see-all-arrow { transition: transform .45s cubic-bezier(.65, 0, .35, 1); }
    .see-all:hover .see-all-arrow, .see-all:focus-visible .see-all-arrow { transform: translateX(8px); }
    @media (max-width: 759px) {
      .row { grid-template-columns: 1fr; }
      .tile, .tile.full { aspect-ratio: 4 / 5; }
    }

    /* Sections after the projects: 12-column grid; everything stacks under 900px */
    .sec { padding: 160px 24px 0; }
    .sec-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; }
    .sec-label, .col-1-3 { grid-column: 1 / 4; }
    .col-1-4 { grid-column: 1 / 5; }
    .sec-body, .col-5-12 { grid-column: 5 / 13; }
    .col-7-12 { grid-column: 7 / 13; }
    @media (max-width: 899px) {
      .sec { padding-top: 96px; }
      .sec-grid { grid-template-columns: 1fr; row-gap: 24px; }
      .sec-label, .sec-body, .col-1-3, .col-1-4, .col-5-12, .col-7-12 { grid-column: 1 / -1; }
    }

    /* Outline button */
    .btn-outline { display: inline-flex; align-items: center; gap: 10px; padding: 14px 24px; border: 1px solid #FFFFFF;
                   font-size: 16px; line-height: 20px; transition: background-color .3s ease, color .3s ease; }
    .btn-outline:hover, .btn-outline:focus-visible { background: #FFFFFF; color: #0B0C0E; }

    /* Footer marquee: two identical groups, moving left to right */
    .mq-track { display: flex; width: max-content; white-space: nowrap; animation: mq 55s linear infinite; }
    .mq-dot { display: inline-block; width: 0.15em; height: 0.15em; border-radius: 50%; background: currentColor;
              margin: 0 0.32em; vertical-align: middle; }
    @keyframes mq { from { transform: translateX(-50%); } to { transform: translateX(0); } }

    /* Mobile menu */
    .menu-mobile { opacity: 0; pointer-events: none; transition: opacity 300ms cubic-bezier(.22, 1, .36, 1); }
    .menu-mobile.is-open { opacity: 1; pointer-events: auto; }

    /* Custom cursor (mouse devices only, enabled by JS): a fast dot and a slow trailing disc layered above it */
    .cursor-dot, .cursor-disc { position: fixed; top: 0; left: 0; border-radius: 50%; pointer-events: none;
                                opacity: 0; transition: opacity .25s ease; will-change: transform; }
    .cursor-dot { z-index: 60; width: 28px; height: 28px; margin: -14px 0 0 -14px; background: #FFFFFF; mix-blend-mode: difference; backface-visibility: hidden; }
    .cursor-disc { z-index: 61; width: 30px; height: 30px; margin: -15px 0 0 -15px; background: #ADB0B7; mix-blend-mode: multiply; }
    .cursor-dot.is-visible, .cursor-disc.is-visible { opacity: 1; }
    html.has-dot, html.has-dot * { cursor: none !important; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .bm, .roll .l, .btn-outline, .menu-mobile, .hdr, .see-all-arrow { transition: none; }
      .mq-track { animation: none; }
    }
    /* Contact page */
    .contact-title { font-size: 6.2vw; font-weight: 500; text-transform: uppercase; letter-spacing: -0.04em; line-height: 1; }
    
    /* Letters scatter on hover and return to a straight line on mouse-out, with a slight bounce */
    .contact-title .ch { display: inline-block; transform-origin: 50% 60%;
                         transition: transform .8s cubic-bezier(.34, 1.45, .64, 1); transition-delay: calc(var(--i) * 30ms); }
    .contact-title .hv-word { display: inline-block; }
    .contact-title .hv-word:hover .ch { transform: translate(var(--x), var(--y)) rotate(var(--r)); }
    @media (prefers-reduced-motion: reduce) {
      .contact-title .ch { transition: none; }
      .contact-title .hv-word { display: inline-block; }
    .contact-title .hv-word:hover .ch { transform: none; }
    }

    /* Pills */
    .pill { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 24px;
            border-radius: 999px; background: #C7CAD1; color: #FFFFFF;
            font-family: "Geist Mono", ui-monospace, "SFMono-Regular", monospace; font-size: 15px; line-height: 20px;
            text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;
            transition: background-color .35s ease, color .35s ease; }
    .pill:hover, .pill:focus-visible { background: #ADB0B7; }

    /* Pill grid: 3 equal columns sized to the widest pill; 1 column on phones */
    .pill-grid { display: inline-grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .pill-grid .pill { width: 100%; }
    .pill-grid .pill-wide { grid-column: 1 / -1; }
    @media (max-width: 599px) { .pill-grid { grid-template-columns: 1fr; width: min(100%, 330px); } .contact-title { font-size: 13vw; } }

    /* "ON DÉMARRE": letters spread across the wide pill so the L lines up with the I of Instagram
       and the last O with the E of Behance (cqw = the pill's own width) */
    .pill.go { container-type: inline-size; padding: 0; }
    .pill.go .swap { width: 100%; justify-items: stretch; text-align: center; }
    .go-spread { display: flex; justify-content: space-between;
                 padding: 0 calc((100cqw - 16px) / 6 - 3.5ch - 0.1em) 0 calc((100cqw - 16px) / 6 - 4.5ch - 0.18em); }
    @media (max-width: 599px) {
      .go-spread { padding: 0 calc(50cqw - 3.5ch - 0.1em) 0 calc(50cqw - 4.5ch - 0.18em); }
    }

    /* Text swap: both labels share one grid cell, so the pill fits the longer one */
    .swap { display: grid; justify-items: center; overflow: hidden; }
    .swap > span { grid-area: 1 / 1; transition: transform .45s cubic-bezier(.65, 0, .35, 1); }
    .swap > span + span { transform: translateY(100%); }
    .pill:hover .swap > span:first-child, .pill:focus-visible .swap > span:first-child { transform: translateY(-100%); }
    .pill:hover .swap > span + span, .pill:focus-visible .swap > span + span { transform: none; }

    @media (prefers-reduced-motion: reduce) {
      .pill, .swap > span { transition: none; }
    }
  </style>
